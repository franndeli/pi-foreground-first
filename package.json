{
  "name": "pi-foreground-first",
  "version": "0.1.0",
  "description": "Foreground-first Pi workflows with user-confirmed Orca terminals and visible agents. No detached task manager or automatic model delegation.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "orca",
    "foreground",
    "agents"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Francisco José Delicado González (https://github.com/franndeli)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/franndeli/pi-foreground-first.git"
  },
  "homepage": "https://github.com/franndeli/pi-foreground-first#readme",
  "bugs": "https://github.com/franndeli/pi-foreground-first/issues",
  "files": [
    "extensions/",
    "lib/",
    "README.md",
    "RELEASING.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.js"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.3.0 <2",
    "typebox": "^1.3.7"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:smoke": "node test/orca-smoke.mjs",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm test"
  }
}
